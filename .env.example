# Skopiuj do .env (docker compose czyta ten plik) lub wyeksportuj w powłoce.
DJANGO_SECRET_KEY=zmien-mnie
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
SITE_NAME=NAZWA_ROBOCZA

# Baza: bez POSTGRES_HOST używany jest SQLite (db.sqlite3).
POSTGRES_HOST=
POSTGRES_DB=slop
POSTGRES_USER=slop
POSTGRES_PASSWORD=slop

# Zadania w tle: 1 = wykonuj natychmiast w procesie www (bez workera), 0 = kolejka huey.
HUEY_IMMEDIATE=1
REDIS_URL=

# Webhook drukarni (HMAC-SHA256 nad surowym body).
PRINTER_WEBHOOK_SECRET=demo-printer-secret
# Opcjonalnie: pełny URL webhooka, gdy mock drukarni ma wołać inny host niż bieżący.
PRINTER_WEBHOOK_URL=
