# Skopiuj do .env (docker compose czyta ten plik) lub wyeksportuj w powłoce.

# Ustawienia: manage.py i testy -> config.settings.development, wsgi/asgi -> config.settings.production.
# Demo na serwerze publicznym (atrapa GH, whitenoise): config.settings.demo, wymaga DJANGO_SECRET_KEY,
# DJANGO_ALLOWED_HOSTS i SITE_URL (https).
# DJANGO_SETTINGS_MODULE=config.settings.production
# W produkcji DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, SITE_URL (https), GH_API_BASE_URL (https) i GH_API_TOKEN są wymagane,
# DJANGO_DEBUG jest ignorowany (zawsze wyłączony).
DJANGO_SECRET_KEY=zmien-mnie
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
SITE_NAME=drukuj-to.me
# Publiczny adres sklepu: linki do plików dla GH i linki w mailach. W produkcji wymagany, https.
SITE_URL=http://localhost:8000
# Prefiks numeru zamówienia (PA-2026-000123); inny dla każdego sklepu podpiętego do tego samego GH.
ORDER_NUMBER_PREFIX=PA
# Produkcja: HSTS w sekundach (domyślnie 30 dni).
# DJANGO_HSTS_SECONDS=2592000

# Baza: bez POSTGRES_HOST używany jest SQLite (db.sqlite3).
POSTGRES_HOST=
POSTGRES_DB=slop
POSTGRES_USER=slop
POSTGRES_PASSWORD=slop

# Zadania w tle: 1 = wykonuj natychmiast w procesie www (bez workera), 0 = kolejka huey.
HUEY_IMMEDIATE=1
REDIS_URL=

# Graphic House (kontrakt v1). Ścieżka = atrapa GH w tym procesie, pełny URL http(s) = prawdziwe GH.
GH_API_BASE_URL=/shop-api/v1
# Token sklepu wydany przez GH. Atrapa akceptuje ten sam token (ustawia go seed_demo).
GH_API_TOKEN=demo-shop-token
# Atrapa GH w tym procesie (API /shop-api/v1/ i pulpit /gh-mock/): 1 = włączona. W produkcji
# zawsze wyłączona, a GH_API_BASE_URL (https) i GH_API_TOKEN są wymagane.
GH_MOCK_ENABLED=1

# Pliki: publiczne (podglądy, PDF-y do druku do czasu podpisanych linków) i prywatne (pliki od
# kupujących, wydawane tylko przez widok). Katalog prywatny nie może leżeć w MEDIA_ROOT.
# MEDIA_ROOT=media
# PRIVATE_MEDIA_ROOT=private_media
